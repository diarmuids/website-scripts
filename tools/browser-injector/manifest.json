{
  "manifest_version": 3,
  "name": "Website Scripts Live Injector",
  "version": "1.0.0",
  "description": "Loads local Website Scripts into matching browser pages and refreshes them after saves.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "userScripts"],
  "host_permissions": [
    "https://plausible.io/*",
    "https://mail.google.com/*",
    "https://www.vipbox.sc/*",
    "https://www.accommodationfortheevent.com/*",
    "https://portal.sjhfulfilment.com/*",
    "*://*.webflow.io/*",
    "https://dev.wsitefiles.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Website Scripts Live Injector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://plausible.io/*",
        "https://mail.google.com/*",
        "https://www.vipbox.sc/*",
        "https://www.accommodationfortheevent.com/*",
        "https://portal.sjhfulfilment.com/*",
        "*://*.webflow.io/*"
      ],
      "js": ["watcher.js"],
      "run_at": "document_idle"
    }
  ]
}
